{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "tests/**/*.js"],
  "exclude": ["vendor"]
}
